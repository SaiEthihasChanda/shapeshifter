<?xml version="1.0" encoding="utf-8"?>
<!-- Tells SignPath what to sign inside the zip that the GitHub Actions workflow uploads. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ShapeShifter-Setup-*.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
